# AI Being Unified - Environment Configuration
# Copy this file to .env and configure your API keys and settings

# =============================================================================
# API KEYS (Required for full functionality)
# =============================================================================

# Primary LLM Provider (Claude - Recommended)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alternative LLM Providers (Optional)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# API Security
API_KEY=ai_being_unified_demo_key_12345

# JWT Secret for authentication (generate a secure random string)
JWT_SECRET_KEY=your_jwt_secret_key_here

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Memory storage path (relative to project root)
MEMORY_STORAGE_PATH=memory

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./ai_being_unified.db

# =============================================================================
# SAFETY AND ENFORCEMENT
# =============================================================================

# Emergency mode (set to true to block all interactions)
EMERGENCY_MODE=false

# Default safety level (safe, caution, danger, critical)
DEFAULT_SAFETY_LEVEL=safe

# Maximum interaction length
MAX_INPUT_LENGTH=2000

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Maximum concurrent tasks
MAX_CONCURRENT_TASKS=3

# LLM timeout (seconds)
LLM_TIMEOUT=30

# Memory cleanup interval (days)
MEMORY_CLEANUP_DAYS=30

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/ai_being_unified.log

# Enable performance monitoring
ENABLE_MONITORING=true

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development mode (enables additional debugging)
DEVELOPMENT_MODE=true

# Mock external services (for testing without API keys)
MOCK_EXTERNAL_SERVICES=false

# Enable CORS for all origins (development only)
ENABLE_CORS_ALL=true

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=your_sentry_dsn_here

# Redis URL for caching (optional)
# REDIS_URL=redis://localhost:6379

# Webhook URL for notifications (optional)
# WEBHOOK_URL=your_webhook_url_here